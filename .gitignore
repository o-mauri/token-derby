# Dependencies & build output
node_modules/
dist/
dist-electron/
build/
*.tsbuildinfo

# electron-builder output
desktop/release/

# electron-builder's buildResources dir holds source assets (app icon), not
# generated output — exempt it from the blanket build/ ignore above.
!desktop/build/
!desktop/build/**

# Shared workspace emits next to its sources rather than into dist/ — ignore the build artifacts.
shared/src/**/*.js
shared/src/**/*.d.ts
shared/src/**/*.js.map

# Test / coverage
coverage/
.nyc_output/

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Workspace tooling
.superpowers/
.worktrees/
.claude/
.aider*
docs/

# CDK
cdk.out/
cdk.context.json

# Docker volumes
docker-data/
