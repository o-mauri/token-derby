{
  "name": "@token-derby/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "npm run build --workspace=@token-derby/shared",
    "build": "ng build ui && ng build site && ng build admin",
    "prebuild:deploy": "npm run build --workspace=@token-derby/shared",
    "build:deploy": "ng build ui && ng build site -c production,optin && ng build admin",
    "test": "ng test ui --watch=false && ng test site --watch=false && ng test admin --watch=false",
    "lint:styles": "stylelint \"projects/**/*.{css,scss}\" --allow-empty-input",
    "pretest": "npm run build --workspace=@token-derby/shared",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook",
    "lint": "ng lint ui && ng lint site && ng lint admin && npm run lint:styles",
    "e2e": "ng build site && ng build admin && tsc --noEmit -p e2e/tsconfig.json && playwright test -c e2e",
    "e2e:opt-in": "npm run build -w @token-derby/site --prefix .. && ng build site -c production,optin && playwright test -c e2e/opt-in/opt-in.config.ts",
    "e2e:ui": "playwright test -c e2e --ui",
    "pree2e": "npm run build --workspace=@token-derby/shared"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@token-derby/shared": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@types/node": "^22.7.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  }
}
